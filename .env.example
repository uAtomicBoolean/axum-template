# Copy this file to .env. Every value has a default in src/config.rs, and a
# line left blank (`STATIC_DIR=`) falls back to that default rather than to an
# empty value.

APP_ADDR=127.0.0.1:3000
DATABASE_URL=sqlite://data/app.db?mode=rwc
DEFAULT_LANG=en

# Folder served under /static. It has to exist: the app refuses to start
# otherwise, rather than serving every page unstyled.
STATIC_DIR=static

# Dart Sass is looked up in PATH. Uncomment to point build.rs at another
# copy: either the executable itself, or the folder that contains it.
# Windows: use forward slashes (E:/bin/sass) or single quotes ('E:\bin\sass'),
# because a bare backslash is an escape character in this file.
#SASS_BIN=/path/to/sass

# Log levels (add sqlx=debug to see SQL statements).
# `axum_template` is the crate name: change it if you rename the crate.
RUST_LOG=axum_template=debug,tower_http=info,info
